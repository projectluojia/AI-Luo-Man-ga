AILUO_HTTP_ADDRESS=127.0.0.1:8080
AILUO_AGENT_ADDRESS=127.0.0.1:50051
AILUO_MANAGE_AGENT=true
# 留空时自动选择 agent/.venv/bin/python 或 Windows Scripts/python.exe。
AILUO_PYTHON=
AILUO_DATABASE_PATH=var/ailuo.db
AILUO_LOAD_DEMO_DATA=false

# 模型配置为必填项，绝不能提交真实密钥。
AILUO_MODEL=your-tool-calling-model
# 生产环境必须使用仅属主可读的密钥文件；开发环境才允许下方原始环境变量。
AILUO_MODEL_API_KEY_FILE=
AILUO_MODEL_API_KEY=
# OpenAI 兼容服务可按需设置；直接使用 OpenAI 时留空。
AILUO_MODEL_BASE_URL=
AILUO_MODEL_TIMEOUT_SECONDS=30
AILUO_MODEL_READINESS_TIMEOUT_SECONDS=3
AILUO_MODEL_MAX_RETRIES=2
AILUO_MODEL_RETRY_BASE_SECONDS=0.25
AILUO_MODEL_RETRY_MAX_SECONDS=2
AILUO_MODEL_REQUESTS_PER_MINUTE=60
AILUO_MODEL_MAX_CONCURRENCY=4

# 日志以中文可读性为主；生产环境建议使用 json。
AILUO_ENVIRONMENT=development
AILUO_LOG_LEVEL=info
AILUO_LOG_FORMAT=console
# 源码路径禁止进入日志，此项必须保持 false。
AILUO_LOG_SOURCE=false
AILUO_LOG_MAX_VALUE_LENGTH=4096
